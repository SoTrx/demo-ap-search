    "step": 1,
    "inputs": [
     {
      "name": "occupation_coding_records",
      "type": "array",
      "required": true,
      "default": ""
     },
     {
      "name": "survey_response_records",
      "type": "array",
      "required": true,
      "default": ""
     },
     {
      "name": "threshold_value",
      "type": "number",
      "required": true,
      "default": ""
     }
    ],
    "outputs": [
     {
      "name": "coded_occupation_records",
      "type": "array",
      "required": true,
      "default": ""
     }
    ]
   }
  },
