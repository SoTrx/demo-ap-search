    "Operator"
   ],
   "properties": {
    "name": "weighted_survey_record_builder",
    "description": "Applies the weight plan to coded response records and adds a numeric weight field to each output record. It returns weighted survey records without changing the underlying response values.",
    "version": "1.0.0",
    "step": 1,
    "inputs": [
     {
      "name": "coded_occupation_records",
      "type": "array",
      "required": true,
