    "Plain_Text_Chunk_Splitter_Operator",
    "Operator"
   ],
   "properties": {
    "name": "plain_text_chunk_splitter",
    "description": "Splits a plain-text document into translatable chunks using the maximum chunk size threshold.",
    "version": "1.0.0",
    "step": 1,
    "inputs": [
     {
      "name": "text",
      "type": "string",
      "required": true,
      "default": ""
