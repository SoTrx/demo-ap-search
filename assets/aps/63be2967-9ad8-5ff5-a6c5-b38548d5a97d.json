    "Operator"
   ],
   "properties": {
    "name": "multilingual_text_recomposer",
    "description": "Reassembles accepted aligned translated chunks into a full translated text, using original source chunks as fallback for unaligned content.",
    "version": "1.0.0",
    "step": 1,
    "inputs": [
     {
      "name": "source_chunks",
      "type": "array",
      "required": true,
      "default": ""
     },
     {
      "name": "translated_chunks",
      "type": "array",
      "required": true,
      "default": ""
     },
     {
      "name": "accepted_segment_alignment",
      "type": "array",
      "required": true,
      "default": ""
     }
    ],
    "outputs": [
     {
      "name": "translated_text",
      "type": "string",
      "required": true,
      "default": ""
     }
    ]
   }
  },
