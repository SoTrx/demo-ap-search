    "Operator"
   ],
   "properties": {
    "name": "pseudonymisation_applier",
    "description": "Applies a pseudonymisation plan to table records and returns pseudonymised table records. Detected direct-identifier values are replaced with reversible pseudonyms, while non-target fields are preserved.",
