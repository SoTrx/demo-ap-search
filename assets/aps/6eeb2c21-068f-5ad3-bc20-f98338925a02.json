  {
   "id": "76e17880-b440-5ae1-8e7a-cd8149176a1c",
   "labels": [
    "Equivalence_Class_Builder_Operator",
    "Operator"
   ],
   "properties": {
    "name": "equivalence_class_builder",
    "description": "Groups pseudonymised records into equivalence classes by their quasi-identifier values. Each group contains the member records that share the same quasi-identifier pattern.",
    "version": "1.0.0",
    "step": 1,
    "inputs": [
     {
      "name": "records",
      "type": "array",
      "required": true,
      "default": ""
     },
     {
      "name": "quasi_report",
      "type": "array",
      "required": true,
      "default": ""
     }
    ],
    "outputs": [
     {
      "name": "groups",
      "type": "array",
      "required": true,
      "default": ""
     }
    ]
   }
  },
  {
   "id": "f403b193-887d-5476-be24-e30bb5c2f6af",
