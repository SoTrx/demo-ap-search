  {
   "id": "526e6bac-8df8-5bf5-b2fc-b83adafb1914",
   "labels": [
    "Reidentification_Risk_Scorer_Operator",
    "Operator"
   ],
   "properties": {
    "name": "reidentification_risk_scorer",
    "description": "Combines k-anonymity, l-diversity, and equivalence-class size evidence into one re-identification risk score. Higher values indicate a greater chance of linking a pseudonymised record to an external dataset.",
    "version": "1.0.0",
    "step": 1,
    "inputs": [
     {
      "name": "k_report",
      "type": "object",
      "required": true,
      "default": ""
     },
     {
      "name": "l_report",
      "type": "object",
      "required": true,
      "default": ""
     },
     {
      "name": "groups",
      "type": "array",
      "required": true,
      "default": ""
     }
    ],
    "outputs": [
     {
      "name": "score",
      "type": "number",
      "required": true,
      "default": ""
     }
    ]
   }
  }
 ],
