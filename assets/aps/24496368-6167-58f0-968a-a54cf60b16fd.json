   }
  },
  {
   "id": "b102906d-ff58-5af6-9d70-59462ada4507",
   "labels": [
    "Diagnosis_Term_Code_Mapper_Operator",
    "Operator"
   ],
   "properties": {
    "name": "diagnosis_coder",
    "description": "Assigns standard codes to diagnosis text fields using terms and synonyms from the supplied medical code set. It appends coded diagnosis fields without removing source text.",
    "version": "1.0.0",
    "step": 1,
    "inputs": [
