    "Operator"
   ],
   "properties": {
    "name": "enrollment_date_window_filter",
    "description": "Keeps patient records whose enrollment date is between the start and end dates. Dates are returned as normalized date strings.",
    "version": "1.0.0",
    "step": 1,
    "inputs": [
     {
      "name": "patient_records",
      "type": "array",
      "required": true,
