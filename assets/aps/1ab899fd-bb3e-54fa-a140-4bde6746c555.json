   "properties": {
    "name": "Medical Survival Dataset Preparation",
    "description": "Filters patient records by enrollment date, adds standard diagnosis codes from a supplied medical term set, and extracts patient identifier, follow-up time, and event indicator into survival records while excluding rows missing those values.",
