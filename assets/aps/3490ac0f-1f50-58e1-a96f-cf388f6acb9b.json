   "labels": [
    "Analytical_Pattern"
   ],
   "properties": {
    "name": "Residual Quasi-Identifier Risk Report",
    "description": "Harmonizes and encodes tabular records, then reports columns and combinations that could uniquely identify individuals after direct personal fields are excluded.",
    "process": "data_integration"
   }
  },
  {
   "id": "4ee3adc9-6b22-53e8-8ba8-a554b50fab04",
   "labels": [
    "Schema_Mapping_Applier_Operator",
    "Operator"
   ],
   "properties": {
    "name": "schema_mapping_applier",
    "description": "Renames columns and converts values in table rows so they conform to a target schema. It applies the supplied column and value mappings without changing the row order.",
    "version": "1.0.0",
    "step": 1,
    "inputs": [
     {
      "name": "table_records",
      "type": "array",
      "required": true,
      "default": ""
     },
     {
      "name": "column_mapping",
      "type": "object",
      "required": true,
      "default": ""
     },
     {
      "name": "value_mapping",
      "type": "object",
      "required": true,
      "default": ""
     }
    ],
    "outputs": [
     {
      "name": "harmonized_records",
      "type": "array",
      "required": true,
      "default": ""
     }
    ]
   }
  },
  {
   "id": "dba827a0-670c-541e-8391-b71c1bd00550",
   "labels": [
    "ResultType",
    "array"
   ],
   "properties": {
    "name": "harmonized_records"
   }
  },
  {
   "id": "d0099a3c-e479-552c-bb7f-821ec9bcec2f",
   "labels": [
    "One_Hot_Encode_Features_Operator",
    "Operator"
   ],
   "properties": {
    "name": "one_hot_encode_features",
    "description": "Converts selected categorical feature columns in table rows into binary indicator columns and removes the original categorical columns.",
    "version": "1.0.0",
    "step": 1,
    "inputs": [
     {
      "name": "rows",
      "type": "array",
      "required": true,
      "default": ""
     },
     {
      "name": "features",
      "type": "object",
      "required": true,
      "default": ""
     }
    ],
    "outputs": [
     {
      "name": "encoded_rows",
      "type": "array",
      "required": true,
      "default": ""
     }
    ]
   }
  },
  {
   "id": "e6b6fcc6-23c5-5849-a0ee-53bb4a32575f",
   "labels": [
    "ResultType",
    "array"
   ],
   "properties": {
