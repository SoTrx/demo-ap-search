   }
  },
  {
   "id": "84a0767a-3cd9-5e7b-83cc-81b6a5837569",
   "labels": [
    "Cox_Proportional_Hazards_Fitter_Operator",
    "Operator"
   ],
   "properties": {
    "name": "cox_hazard_fitter",
    "description": "Fits a Cox proportional hazards model to survival records using covariates named in the column mapping. The output is a regression fit containing hazard ratios and model diagnostics.",
    "version": "1.0.0",
    "step": 1,
    "inputs": [
     {
      "name": "survival_records",
      "type": "array",
      "required": true,
      "default": ""
     },
     {
      "name": "column_mapping",
      "type": "object",
      "required": true,
      "default": ""
     }
    ],
    "outputs": [
     {
      "name": "regression_fit",
      "type": "object",
      "required": true,
      "default": ""
     }
    ]
   }
  },
  {
