  {
   "id": "e7ad215b-04ec-535a-8edd-539fa3985c66",
   "labels": [
    "Regression_Prediction_Operator",
    "Operator"
   ],
   "properties": {
    "name": "regression_prediction_interval",
    "description": "Applies a fitted regression model to new table rows to produce predicted values with prediction intervals. The threshold value controls the width of the intervals.",
