   ],
   "properties": {
    "name": "Cox Patient Survival Prediction Scorer",
    "description": "Builds survival analysis records from coded patient tables and a column mapping, fits a Cox proportional hazards model, and scores new rows to return interval-wrapped predictions controlled by alpha.",
    "process": "health_biomedical"
   }
  },
  {
   "id": "d4105bdf-c079-5d5f-b62f-7b23ece268c8",
   "labels": [
    "Survival_Event_Table_Builder_Operator",
    "Operator"
   ],
   "properties": {
    "name": "survival_table_builder",
    "description": "Builds survival records from coded patient records by extracting patient identifier, follow-up time, and event indicator columns named in the column mapping. Records with missing time or event values are excluded.",
    "version": "1.0.0",
    "step": 1,
    "inputs": [
     {
      "name": "coded_patient_records",
      "type": "array",
      "required": true,
      "default": ""
     },
     {
      "name": "column_mapping",
      "type": "object",
      "required": true,
      "default": ""
     }
    ],
    "outputs": [
     {
      "name": "survival_records",
      "type": "array",
      "required": true,
      "default": ""
     }
    ]
   }
  },
  {
