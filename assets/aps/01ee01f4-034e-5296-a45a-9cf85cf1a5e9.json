   "properties": {
    "name": "Validated Translation Segment Alignment",
    "description": "The AP splits a plain-text document into ordered chunks, cleans translated chunks against the source, aligns source and translated segments using length, order, and content cues, filters alignments by an acceptance threshold, and returns a validation report with only the accepted alignments.",
