   "properties": {
    "name": "Entity Graph Query Result Rows",
    "description": "Given unlinked entity records, a graph schema, text chunks, and a graph query plan, it resolves entity mentions to candidate graph nodes, derives schema-compatible relation triples from the chunks, and executes the query to return matching result rows.",
