   ],
   "properties": {
    "name": "Weighted Occupation Crosstab First Rows",
    "description": "Creates occupation-specific survey weights from coded responses and benchmark shares, applies them, cross-tabulates mapped variables, and returns the first limited rows with unweighted counts, weighted counts, and percentages.",
