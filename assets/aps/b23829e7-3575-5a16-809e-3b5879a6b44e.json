      "name": "value_mapping",
      "type": "object",
      "required": true,
      "default": ""
     }
    ],
    "outputs": [
     {
      "name": "survey_weight_plan",
      "type": "object",
      "required": true,
      "default": ""
     }
    ]
   }
  },
