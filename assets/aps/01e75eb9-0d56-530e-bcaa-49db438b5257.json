    "step": 1,
    "inputs": [
     {
      "name": "weighted_survey_records",
      "type": "array",
      "required": true,
      "default": ""
     },
     {
      "name": "column_mapping",
      "type": "object",
      "required": true,
      "default": ""
     }
    ],
    "outputs": [
