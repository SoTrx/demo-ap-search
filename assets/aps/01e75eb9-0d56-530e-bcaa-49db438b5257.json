   ],
   "properties": {
    "name": "Weighted Survey Occupation Aggregates",
    "description": "Applies survey weights to coded occupation records, builds weighted cross-tabulation estimates for mapped variables, converts those estimates into region-time readings, and summarizes the selected metric by region and period.",
    "process": "occupations_surveys"
   }
  },
  {
