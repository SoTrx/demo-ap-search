   ],
   "properties": {
    "name": "Aligned Multilingual Graph Triple Builder",
    "description": "This AP rebuilds the full translated text from accepted segment-aligned translated chunks with source fallback, resegments it, extracts typed relation candidates for linked entities under a graph schema, and outputs schema-valid graph triples.",
    "process": "translation_multilingual"
   }
  },
