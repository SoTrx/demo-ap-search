   ],
   "properties": {
    "name": "Profile-Aware Dataset Candidate Ranking",
    "description": "Extracts weighted key phrases from text chunks, searches an index for a limited set of dataset candidates, and reranks those candidates by compatibility with a reference dataset profile.",
    "process": "text_nlp"
   }
  },
  {
   "id": "5ffc28fa-e0ff-5726-80c2-918533097123",
   "labels": [
    "Chunk_Keyword_Extractor_Operator",
    "Operator"
   ],
   "properties": {
    "name": "chunk_keyword_extractor",
    "description": "Extracts weighted key phrases from an array of text chunks and returns keyword records.",
    "version": "1.0.0",
    "step": 1,
    "inputs": [
     {
      "name": "chunks",
      "type": "array",
      "required": true,
      "default": ""
     }
    ],
    "outputs": [
