   "labels": [
    "DatasetDiscoveryReranker_Operator",
    "Operator"
   ],
   "properties": {
    "name": "rerank_dataset_candidates",
    "description": "Reranks candidate dataset identifiers against a reference dataset profile. It puts candidates with more compatible schema and coverage characteristics first.",
    "version": "1.0.0",
    "step": 1,
    "inputs": [
     {
      "name": "candidates",
      "type": "array",
      "required": true,
      "default": ""
     },
     {
      "name": "reference_profile",
      "type": "object",
      "required": true,
      "default": ""
     }
    ],
    "outputs": [
     {
      "name": "ranked_candidates",
      "type": "array",
      "required": true,
      "default": ""
     }
    ]
   }
  }
 ],
