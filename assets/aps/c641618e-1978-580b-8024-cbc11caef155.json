   "labels": [
    "Equivalence_Class_Builder_Operator",
    "Operator"
   ],
   "properties": {
    "name": "equivalence_class_builder",
    "description": "Groups pseudonymised records into equivalence classes by their quasi-identifier values. Each group contains the member records that share the same quasi-identifier pattern.",
    "version": "1.0.0",
    "step": 1,
    "inputs": [
     {
      "name": "records",
      "type": "array",
      "required": true,
      "default": ""
     },
     {
      "name": "quasi_report",
      "type": "array",
      "required": true,
      "default": ""
     }
    ],
    "outputs": [
     {
      "name": "groups",
      "type": "array",
      "required": true,
      "default": ""
     }
    ]
   }
  },
  {
   "id": "47b6d227-8a4c-5d26-9f16-66f8bba58d3f",
   "labels": [
