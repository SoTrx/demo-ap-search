   ],
   "properties": {
    "name": "Pseudonymised Dataset Re-identification Risk Score",
    "description": "It examines records that have had direct personal details removed, groups records sharing the same quasi-identifier pattern, and combines k-anonymity, l-diversity, and group-size evidence into one numeric re-identification risk score.",
    "process": "privacy_anonymisation"
   }
  },
  {
   "id": "df761248-df4a-5025-8b64-309a425d0fe3",
   "labels": [
    "Quasi_Identifier_Detector_Operator",
    "Operator"
   ],
   "properties": {
    "name": "quasi_identifier_detector",
    "description": "Identifies quasi-identifier columns and combinations that could uniquely identify records after direct personal data is removed. It uses the personal-data report to avoid treating direct identifiers as quasi-identifiers.",
    "version": "1.0.0",
    "step": 1,
    "inputs": [
     {
      "name": "records",
      "type": "array",
      "required": true,
      "default": ""
     },
