   "labels": [
    "Schema_Relevance_Filter_Operator",
    "Operator"
   ],
   "properties": {
    "name": "Schema Relevance Filter",
    "description": "Filters a database schema down to tables and columns relevant to a subject topic and returns the reduced schema.",
