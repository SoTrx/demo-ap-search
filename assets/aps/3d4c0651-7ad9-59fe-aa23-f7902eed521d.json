   ],
   "properties": {
    "name": "Relevant Schema Query Safety Check",
    "description": "The AP narrows a database schema to a subject topic, rewrites an SQL query for better performance against the narrowed schema, and returns a Boolean flag indicating whether the rewritten query references only the narrowed tables and columns.",
    "process": "sql_analytics"
   }
  },
  {
