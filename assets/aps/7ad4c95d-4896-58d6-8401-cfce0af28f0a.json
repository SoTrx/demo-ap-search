   "properties": {
    "name": "Graph Expanded Patient Code Filter",
    "description": "Extract schema-guided relation triples from linked text entities, expand a base medical code set through the resulting parent-child triples, and return coded patient records containing a diagnosis in the expanded set.",
    "process": "knowledge_graphs"
   }
  },
