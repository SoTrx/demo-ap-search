   "labels": [
    "Clinical_Patient_Record_Filter_Operator",
    "Operator"
   ],
   "properties": {
    "name": "patient_record_filter",
    "description": "Filters clinical table rows to patient-level records and keeps only the columns named in the column mapping. Rows without a patient identifier are excluded.",
    "version": "1.0.0",
    "step": 1,
    "inputs": [
