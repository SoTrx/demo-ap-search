   "properties": {
    "name": "Clinical Survival Records Builder",
    "description": "It converts clinical table rows into survival-ready records by retaining mapped patient-level fields, restricting enrollment dates, appending standard diagnosis codes, and dropping rows without follow-up time or event indicators.",
    "process": "health_biomedical"
   }
  },
  {
