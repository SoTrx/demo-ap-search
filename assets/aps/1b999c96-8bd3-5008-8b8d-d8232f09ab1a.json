  {
   "id": "1b999c96-8bd3-5008-8b8d-d8232f09ab1a",
   "labels": [
    "Analytical_Pattern"
   ],
   "properties": {
    "name": "Safety-Gated Weather Time Series",
    "description": "It checks a weather comparison report against an absolute variance limit, runs a supplied SQL query only when the check passes, normalizes the resulting rows into records for one weather variable, and returns an ordered numeric time series.",
    "process": "finance_economics"
   }
  },
  {
   "id": "02da910e-6fc4-53d9-b53d-8f1a30fc52dd",
   "labels": [
    "Budget_Variance_Safety_Flag_Operator",
    "Operator"
   ],
   "properties": {
    "name": "budget_variance_safety_flag",
    "description": "Checks period variances in the comparison report against the supplied absolute limit. It returns a safety flag that is true when every period variance is within the limit.",
    "version": "1.0.0",
    "step": 1,
    "inputs": [
     {
      "name": "comparison",
      "type": "object",
      "required": true,
      "default": ""
     },
     {
      "name": "limit",
      "type": "number",
      "required": true,
      "default": ""
     }
    ],
    "outputs": [
     {
      "name": "safe",
      "type": "boolean",
      "required": true,
      "default": ""
     }
    ]
   }
  },
  {
   "id": "91badeef-bc1e-559c-8f49-d1636c33627e",
