    "Performance_Trend_Summarizer_Operator",
    "Operator"
   ],
   "properties": {
    "name": "performance_trend_summarizer",
    "description": "Summarizes the trend in a student's result rows over recent attempts, such as improving, declining, or stable. Returns a plain-text trend description.",
    "version": "1.0.0",
    "step": 1,
    "inputs": [
     {
      "name": "assessment_rows",
      "type": "array",
      "required": true,
      "default": ""
