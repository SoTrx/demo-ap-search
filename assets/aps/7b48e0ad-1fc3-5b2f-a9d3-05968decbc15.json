   "properties": {
    "name": "Duplicate-aware Spearman Significance Test",
    "description": "Deduplicates tabular records using supplied duplicate groups, computes Spearman correlations for mapped numeric columns, and returns pair-level significance p-values and decisions at a chosen alpha.",
