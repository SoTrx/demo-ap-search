   "labels": [
    "Test_Recommendation_Operator",
    "Operator"
   ],
   "properties": {
    "name": "Test Recommendation",
    "description": "Selects MathE multiple-choice questions (statement, answer options, index of the correct option), returned as JSON text, suited to a student's proficiency level on a MathE topic. Returns the questions only, without any explanation of the answers.",
    "version": "1.0.0",
    "step": 1,
    "inputs": [
     {
      "name": "level",
      "type": "number",
      "required": true,
      "default": 0.5
