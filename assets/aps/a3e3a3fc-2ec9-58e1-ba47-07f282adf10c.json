   }
  },
  {
   "id": "5662f298-0cd9-5a35-8bb2-dabc263aa54a",
   "labels": [
    "SQL_Schema_Validator_Operator",
    "Operator"
   ],
   "properties": {
    "name": "SQL Schema Validator",
    "description": "Checks whether an SQL query references only tables and columns present in the schema and returns a safety flag.",
    "version": "1.0.0",
    "step": 1,
    "inputs": [
     {
      "name": "query",
      "type": "string",
      "required": true,
      "default": ""
     },
     {
      "name": "schema",
      "type": "string",
      "required": true,
      "default": ""
     }
    ],
    "outputs": [
     {
      "name": "flag",
      "type": "boolean",
      "required": true,
      "default": ""
     }
    ]
   }
  },
  {
   "id": "4ac0bdb8-e8aa-5e63-adb4-08acf8ce66f1",
   "labels": [
    "ResultType",
