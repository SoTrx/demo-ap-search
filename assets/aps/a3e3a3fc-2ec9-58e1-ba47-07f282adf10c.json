   "labels": [
    "Analytical_Pattern"
   ],
   "properties": {
    "name": "Safe Topic-Based SQL Execution",
    "description": "It narrows a database schema to a subject topic, checks that a supplied query uses only the remaining tables and columns, and executes the safe SQL to return result rows.",
    "process": "sql_analytics"
   }
  },
  {
   "id": "66094511-e116-5ab2-ad18-a2cb4a2677a7",
   "labels": [
    "Schema_Relevance_Filter_Operator",
    "Operator"
   ],
   "properties": {
    "name": "Schema Relevance Filter",
    "description": "Filters a database schema down to tables and columns relevant to a subject topic and returns the reduced schema.",
    "version": "1.0.0",
    "step": 1,
    "inputs": [
     {
      "name": "schema",
      "type": "string",
      "required": true,
      "default": ""
     },
     {
      "name": "topic",
      "type": "string",
      "required": true,
      "default": ""
     }
    ],
    "outputs": [
     {
      "name": "schema",
      "type": "string",
      "required": true,
      "default": ""
     }
    ]
   }
  },
  {
