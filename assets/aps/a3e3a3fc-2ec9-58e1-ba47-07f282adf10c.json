   }
  },
  {
   "id": "3e11c76b-1dc3-59ce-858b-cba9706789ac",
   "labels": [
    "SQL_Query_Operator",
    "Operator"
   ],
   "properties": {
    "name": "SQL Execution",
    "description": "Executes an SQL query against the input dataset and returns the result rows.",
    "version": "1.0.0",
    "step": 1,
    "inputs": [
     {
      "name": "sql",
      "type": "string",
      "required": true,
      "default": ""
     },
     {
      "name": "is_safe",
      "type": "boolean",
      "required": true,
      "default": true
     }
    ],
    "outputs": [
     {
      "name": "result",
      "type": "array",
      "required": true,
      "default": []
     }
    ]
   }
  }
 ],
