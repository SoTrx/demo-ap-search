 "nodes": [
  {
   "id": "8baf9639-c36e-5a76-80cc-c99076b45141",
   "labels": [
    "Analytical_Pattern"
   ],
   "properties": {
    "name": "Profile-aware dataset candidate ranking",
    "description": "Convert a dataset question into keyword records, keep those above a relevance threshold, retrieve up to a limit of dataset identifiers from an index, and reorder the identifiers by compatibility with a reference dataset profile.",
    "process": "dataset_discovery"
   }
  },
  {
   "id": "22e49bb9-c332-57df-bf41-11f047a959e8",
   "labels": [
    "DatasetSearchQueryBuilder_Operator",
    "Operator"
   ],
   "properties": {
    "name": "build_dataset_search_query",
    "description": "Translates a natural-language dataset question into keyword records for catalogue search. It expands each requested topic into searchable terms and facets.",
    "version": "1.0.0",
    "step": 1,
    "inputs": [
     {
      "name": "question",
      "type": "string",
      "required": true,
      "default": ""
     }
    ],
    "outputs": [
     {
      "name": "keywords",
      "type": "array",
      "required": true,
      "default": ""
     }
    ]
   }
  },
  {
   "id": "ccf21c44-a4ec-5e2e-bb20-2d3b07304e95",
   "labels": [
    "ResultType",
    "array"
   ],
   "properties": {
    "name": "keywords"
   }
  },
  {
   "id": "9612494d-ab47-5dbb-afde-c38af3e648c0",
   "labels": [
    "Keyword_Threshold_Filter_Operator",
    "Operator"
   ],
   "properties": {
    "name": "keyword_threshold_filter",
    "description": "Keeps keyword records whose relevance score meets the supplied threshold.",
    "version": "1.0.0",
    "step": 1,
    "inputs": [
     {
      "name": "keywords",
      "type": "array",
      "required": true,
      "default": ""
     },
     {
      "name": "threshold",
      "type": "number",
      "required": true,
      "default": ""
     }
    ],
    "outputs": [
     {
      "name": "filtered_keywords",
      "type": "array",
      "required": true,
      "default": ""
     }
    ]
   }
  },
  {
   "id": "9ff707c5-0872-57a9-a3a1-71531f55e673",
   "labels": [
