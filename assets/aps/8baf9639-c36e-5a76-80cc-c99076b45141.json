  },
  {
   "id": "9da38756-e70c-59c5-9ca5-49f7e7b75a60",
   "labels": [
    "DatasetCatalogueSearcher_Operator",
    "Operator"
   ],
   "properties": {
    "name": "search_dataset_catalogue",
    "description": "Searches a dataset retrieval index using keyword records and returns ranked dataset identifiers. It applies the recommendation limit to the candidate list.",
    "version": "1.0.0",
    "step": 1,
    "inputs": [
     {
      "name": "keywords",
      "type": "array",
      "required": true,
      "default": ""
     },
     {
      "name": "index",
      "type": "object",
      "required": true,
      "default": ""
     },
     {
      "name": "limit",
      "type": "number",
      "required": true,
      "default": ""
     }
    ],
    "outputs": [
     {
      "name": "candidates",
      "type": "array",
      "required": true,
      "default": ""
     }
    ]
   }
  },
  {
   "id": "bc5085c5-d670-5f40-88aa-0330f6c637b8",
   "labels": [
    "ResultType",
    "array"
   ],
   "properties": {
