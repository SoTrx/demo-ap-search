   "properties": {
    "name": "Patient Enrollment Diagnosis Coder",
    "description": "Takes raw clinical table records with a field mapping, keeps patient-level rows without missing identifiers in an enrollment date range, and appends standardized diagnosis codes to diagnosis text.",
