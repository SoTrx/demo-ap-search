   ],
   "properties": {
    "name": "quasi_identifier_detector",
    "description": "Identifies quasi-identifier columns and combinations that could uniquely identify records after direct personal data is removed. It uses the personal-data report to avoid treating direct identifiers as quasi-identifiers.",
    "version": "1.0.0",
    "step": 1,
    "inputs": [
     {
      "name": "records",
      "type": "array",
      "required": true,
      "default": ""
