   "labels": [
    "Analytical_Pattern"
   ],
   "properties": {
    "name": "Re-identification Risk from Encoded Data",
    "description": "It harmonizes records to a target schema, encodes selected categorical columns as flags, and reports quasi-identifier combinations that could uniquely identify records after direct personal fields are excluded.",
    "process": "data_integration"
   }
  },
  {
   "id": "30d1b40a-5739-57a2-b37e-87b0d92729a2",
   "labels": [
    "Value_Mapping_Recommender_Operator",
    "Operator"
   ],
   "properties": {
    "name": "value_mapping_recommender",
    "description": "Recommends value-level translations that make mapped columns compatible. It uses the column mapping and the domain comparison report.",
    "version": "1.0.0",
    "step": 1,
    "inputs": [
     {
      "name": "column_mapping",
      "type": "object",
      "required": true,
      "default": ""
